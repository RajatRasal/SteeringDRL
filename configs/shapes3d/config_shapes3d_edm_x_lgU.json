{
    "model": {
        "type": "image_v1",
        "input_channels": 3,
        "input_size": [16, 16],
        "patch_size": 1,
        "mapping_out": 16,
        "depths": [2, 2, 2],
        "channels": [64, 128, 256],
        "self_attn_depths": [true, true, true],
        "cross_attn_depths": [true, true, true],
        "cross_cond_dim": 16,
        "has_variance": false,
        "loss_config": "karras_x",
        "loss_weighting": "karras",
        "dropout_rate": 0.1,
        "sigma_data": 0.5,
        "sigma_min": 1e-2,
        "sigma_max": 80,
        "augment_wrapper": false,
        "sigma_sample_density": {
            "type": "loguniform",
            "min_value": 1e-2,
            "max_value": 80
        }
    },
    "encoder": {
        "type": "image",
        "internal_dim": 128,
        "context_dim": 16,
        "latent_units": 10
    },
    "dataset": {
        "type": "shapes3d"
    },
    "optimizer": {
        "type": "adamw",
        "lr": 5e-4,
        "betas": [0.95, 0.999],
        "eps": 1e-6,
        "weight_decay": 1e-3
    },
    "lr_sched": {
        "type": "constant",
        "warmup": 0.0
    },
    "ema_sched": {
        "type": "inverse",
        "power": 0.6667,
        "max_value": 0.9999
    }
}
